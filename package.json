{
  "name": "timesheet-tracker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Tempo - time tracker for Odoo timesheets",
  "main": "electron/main.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "test": "concurrently \"npm run test:server\" \"npm run test:client\"",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "build:server-bundle": "esbuild server/src/app.ts --bundle --platform=node --format=esm --outfile=electron/server-bundle.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "build:client": "npm run build --workspace=client",
    "dev:electron": "npm run build:server-bundle && concurrently -k \"npm run dev:client\" \"electron . --dev\"",
    "build:app": "npm run build:client && npm run build:server-bundle && electron-builder",
    "install:app": "pkill -f 'Tempo' || true; sleep 1; cp -R 'dist-electron/mac-arm64/Tempo.app' /Applications/ && open '/Applications/Tempo.app'"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.0"
  },
  "build": {
    "appId": "com.timesheet.tracker",
    "productName": "Tempo",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*"
    ],
    "mac": {
      "icon": "electron/icons/icon.icns",
      "category": "public.app-utility",
      "target": [
        "dir"
      ]
    }
  }
}
